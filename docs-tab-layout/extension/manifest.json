{
  "manifest_version": 3,
  "name": "Docs Tab Layout",
  "version": "0.1.0",
  "description": "Open Google Docs with collapsed tab branches and save a custom opening layout per document.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://docs.google.com/*"],
  "content_scripts": [{
    "matches": ["https://docs.google.com/document/d/*", "https://docs.google.com/document/u/*"],
    "js": ["core.js", "adapter.js", "controller.js", "store.js", "content.js"],
    "run_at": "document_end"
  }],
  "action": {
    "default_title": "Docs Tab Layout",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "browser_specific_settings": {
    "gecko": {
      "id": "docs-tab-layout@personal.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  }
}
